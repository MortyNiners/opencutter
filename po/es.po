#: src/opencutter/gui/dialogs.py
msgid "A job is running"
msgstr "Hay un trabajo en curso"

#: src/opencutter/gui/dialogs.py
msgid "Cancel the job and quit? The machine stops right away."
msgstr "¿Cancelar el trabajo y salir? La máquina se detiene al instante."

#: src/opencutter/gui/dialogs.py
msgid "Keep cutting"
msgstr "Seguir cortando"

#: src/opencutter/gui/dialogs.py
msgid "Cancel Job and quit"
msgstr "Cancelar trabajo y salir"

#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid "Connection lost during the job"
msgstr "Se perdió la conexión durante el trabajo"

#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid ""
"OpenCutter cannot stop the machine without the connection. If it is still "
"moving, press its power button. Then switch it on again to reconnect."
msgstr ""
"OpenCutter no puede detener la máquina sin la conexión. Si todavía se mueve, "
"pulse su botón de encendido. Luego vuelva a encenderla para reconectar."

#: src/opencutter/gui/dialogs.py
msgid "Close"
msgstr "Cerrar"

#: src/opencutter/gui/dialogs.py
msgid "Reconnect"
msgstr "Reconectar"

#: src/opencutter/gui/dialogs.py
msgid "The stop could not be sent"
msgstr "No se pudo enviar la orden de parada"

#: src/opencutter/gui/dialogs.py
msgid ""
"Press the machine's power button now. The window stays open; close it again "
"once the machine has stopped."
msgstr ""
"Pulse ahora el botón de encendido de la máquina. La ventana sigue abierta; "
"ciérrela de nuevo cuando la máquina se haya detenido."

#: src/opencutter/gui/dialogs.py
msgid "OK"
msgstr "Aceptar"

#: src/opencutter/gui/dialogs.py
msgid ""
"OpenCutter could not send the stop to the machine. If it moves, press its "
"power button now."
msgstr ""
"OpenCutter no pudo enviar la orden de parada a la máquina. Si se mueve, "
"pulse ahora su botón de encendido."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Busy"
msgstr "La máquina sigue indicando Ocupada"

#: src/opencutter/gui/dialogs.py
msgid ""
"The stop was sent, but the machine still reports Busy. If it moves, press "
"its power button now."
msgstr ""
"Se envió la orden de parada, pero la máquina sigue indicando Ocupada. Si se "
"mueve, pulse ahora su botón de encendido."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Paused"
msgstr "La máquina sigue indicando En pausa"

