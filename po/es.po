#: src/opencutter/gui/connection.py
msgid "Pair the machine once in <b>Settings → Bluetooth</b>."
msgstr "Empareje la máquina una vez en <b>Configuración → Bluetooth</b>."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"The {name} accepts a Bluetooth connection only right after it is switched "
"on. If the app can’t connect, switch the machine off and on."
msgstr ""
"La {name} solo acepta una conexión Bluetooth justo después de encenderla. Si "
"la aplicación no puede conectarse, apague la máquina y vuelva a encenderla."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "If the app can’t connect to the {name}, switch the machine off and on."
msgstr ""
"Si la aplicación no puede conectarse a la {name}, apague la máquina y vuelva "
"a encenderla."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"Make sure the {name} is switched on and paired. If it still fails, switch it "
"off and on again."
msgstr ""
"Compruebe que la {name} está encendida y emparejada. Si sigue fallando, "
"apáguela y vuelva a encenderla."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "Make sure the {name} is switched on and paired."
msgstr "Compruebe que la {name} está encendida y emparejada."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "Releases the {name} so other apps can connect to it."
msgstr "Libera la {name} para que otras aplicaciones puedan conectarse a ella."

#: src/opencutter/gui/connection.py
msgid "Available when the job has ended."
msgstr "Disponible cuando termine el trabajo."

#: src/opencutter/gui/connection.py
msgid "Scanning for devices"
msgstr "Buscando dispositivos"

