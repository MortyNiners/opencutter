#: src/opencutter/gui/jobview.py
msgid "If the machine keeps moving, press its power button."
msgstr "Si la máquina sigue moviéndose, pulse su botón de encendido."

#: src/opencutter/gui/jobview.py
msgid "The stop could not be sent. Press the machine's power button now."
msgstr ""
"No se pudo enviar la orden de parada. Pulse ahora el botón de encendido de "
"la máquina."

#: src/opencutter/gui/jobview.py
msgid "Stopping…"
msgstr "Deteniendo…"

#: src/opencutter/gui/jobview.py
msgid ""
"Waiting for the machine to confirm the stop. If the machine keeps moving, "
"press its power button."
msgstr ""
"Esperando a que la máquina confirme la parada. Si la máquina sigue "
"moviéndose, pulse su botón de encendido."

#: src/opencutter/gui/jobview.py
msgid "Nothing was sent"
msgstr "No se envió nada"

#: src/opencutter/gui/jobview.py
msgid ""
"Before the next job: check that the tool is up, press <b>Unload</b>, then "
"load the mat."
msgstr ""
"Antes del próximo trabajo: compruebe que la herramienta está arriba, pulse "
"<b>Descargar</b> y luego cargue el tapete."

#: src/opencutter/gui/jobview.py
msgid ""
"Once the machine has stopped, check that the tool is up and load the mat "
"again before the next job."
msgstr ""
"Cuando la máquina se haya detenido, compruebe que la herramienta está arriba "
"y vuelva a cargar el tapete antes del próximo trabajo."

#: src/opencutter/gui/jobview.py
msgid ""
"Press <b>Unload</b> on the machine to remove the mat. Load the mat again "
"right before the next job."
msgstr ""
"Pulse <b>Descargar</b> en la máquina para sacar el tapete. Vuelva a cargarlo "
"justo antes del próximo trabajo."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid ""
"The connection to the {name} was lost while the job waited at the outline "
"check, so the stop could not be sent. The machine was waiting there with the "
"tool up; nothing more was sent. If it moves, press its power button."
msgstr ""
"Se perdió la conexión con la {name} mientras el trabajo esperaba en la "
"comprobación del contorno, así que no se pudo enviar la orden de parada. La "
"máquina esperaba allí con la herramienta arriba; no se envió nada más. Si se "
"mueve, pulse su botón de encendido."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid "The connection to the {name} was lost. Nothing more is sent."
msgstr "Se perdió la conexión con la {name}. No se envía nada más."

#: src/opencutter/gui/jobview.py
msgid ""
"The connection was lost while the job waited here, so Cut cannot be sent in "
"this job: press Cancel."
msgstr ""
"Se perdió la conexión mientras el trabajo esperaba aquí, así que en este "
"trabajo ya no se puede enviar «Cortar»: pulse «Cancelar»."

#: src/opencutter/gui/jobview.py
msgid ""
"The machine still reports Busy. If it moves, press Stop Machine or its power "
"button."
msgstr ""
"La máquina sigue indicando Ocupada. Si se mueve, pulse «Detener» o su botón "
"de encendido."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid ""
"The stop has not reached the {name} yet: OpenCutter sends it as soon as the "
"{name} is connected again. If it moves, press its power button."
msgstr ""
"La orden de parada aún no ha llegado a la {name}: OpenCutter la enviará en "
"cuanto la {name} vuelva a estar conectada. Si se mueve, pulse su botón de "
"encendido."

#: src/opencutter/gui/jobview.py
msgid "Stop Machine"
msgstr "Detener"

#: src/opencutter/gui/jobview.py
msgid "Send Again…"
msgstr "Enviar de nuevo…"

#: src/opencutter/gui/jobview.py
msgid "Cut Again"
msgstr "Cortar de nuevo"

#: src/opencutter/gui/jobview.py
#: src/opencutter/gui/runner.py
