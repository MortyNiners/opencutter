msgstr "la máquina no responde (la conexión está caída)"

#: src/opencutter/device/daemon.py
msgid "a stop was asked for: the job is ending"
msgstr "se pidió una parada: el trabajo está terminando"

#: src/opencutter/device/daemon.py
msgid "the job is ending"
msgstr "el trabajo está terminando"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid "the {model} has not been tested with resume: press its Pause key"
msgstr ""
"la {model} no se ha probado con la orden de reanudar: pulse su tecla Pausa"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid "the {model} has not been tested with pause: press its Pause key"
msgstr ""
"la {model} no se ha probado con la orden de pausar: pulse su tecla Pausa"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid "the machine is not paused ({shown})"
msgstr "la máquina no está en pausa ({shown})"

#: src/opencutter/device/daemon.py
msgid "the job has not started yet"
msgstr "el trabajo aún no ha empezado"

#: src/opencutter/device/daemon.py
msgid "the machine is already paused"
msgstr "la máquina ya está en pausa"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid "the machine is neither ready nor busy ({shown})"
msgstr "la máquina no está ni lista ni ocupada ({shown})"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the machine is not answering (its status could not be read within {seconds} "
"s)"
msgstr "la máquina no responde (no se pudo leer su estado en {seconds} s)"

#: src/opencutter/device/daemon.py
msgid "the machine is not answering (no reply to ESC 05)"
msgstr "la máquina no responde (ninguna respuesta a ESC 05)"

#: src/opencutter/device/daemon.py
msgid ""
"the machine's status could not be read for sure (an earlier reply is still "
"due); try again"
msgstr ""
"no se pudo leer con seguridad el estado de la máquina (todavía falta una "
"respuesta anterior); inténtelo de nuevo"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the resume write failed ({error}); whether it arrived is unknown, and it is "
"not sent again"
msgstr ""
"falló la escritura de la orden de reanudar ({error}); no se sabe si llegó, y "
"no se vuelve a enviar"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the pause write failed ({error}); whether it arrived is unknown, and it is "
"not sent again"
msgstr ""
"falló la escritura de la orden de pausar ({error}); no se sabe si llegó, y "
"no se vuelve a enviar"

#: src/opencutter/device/protocol.py
msgid ""
"Do not press Pause to continue: press Unload on the machine (or switch it "
"off and on), check that the tool is up, then load the Cutting Mat right "
"before the job."
msgstr ""
"No pulse Pausa para continuar: pulse «Descargar» en la máquina (o apáguela y "
"vuelva a encenderla), compruebe que la herramienta está arriba y luego "
"cargue el tapete de corte justo antes del trabajo."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is busy ({shown}): it is still working, or another connection "
"such as USB holds it. Nothing was sent. Wait until it shows Ready, then try "
"again."
msgstr ""
"La máquina está ocupada ({shown}): todavía está trabajando, u otra conexión, "
"como USB, la tiene ocupada. No se envió nada. Espere a que indique Lista e "
"inténtelo de nuevo."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "The machine is paused ({shown}). Nothing was sent. {advice}"
msgstr "La máquina está en pausa ({shown}). No se envió nada. {advice}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is still ending a cancel ({shown}). Nothing was sent. Wait until "
"it shows Ready or Load Media. {advice}"
msgstr ""
"La máquina todavía está terminando una cancelación ({shown}). No se envió "
"nada. Espere a que indique Lista o Cargar hoja. {advice}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine rejected a command ({shown}): another connection, such as USB, "
"held it. Nothing was sent. Close the other connection, then try again."
msgstr ""
"La máquina rechazó una orden ({shown}): otra conexión, como USB, la tenía "
"ocupada. No se envió nada. Cierre la otra conexión e inténtelo de nuevo."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is not ready ({shown}). Load the Cutting Mat on the machine "
"right before the job."
msgstr ""
"La máquina no está lista ({shown}). Cargue el tapete de corte en la máquina "
"justo antes del trabajo."

#: src/opencutter/device/protocol.py
msgid ""
"This machine did not report its model. OpenCutter cannot drive it and will "
"not send anything to it."
msgstr ""
"Esta máquina no indicó su modelo. OpenCutter no puede controlarla y no le "
"enviará nada."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"This machine reports itself as \"{model}\". OpenCutter cannot drive it and "
"will not send anything to it."
msgstr ""
"Esta máquina se identifica como «{model}». OpenCutter no puede controlarla y "
"no le enviará nada."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"This machine reports itself as \"{model}\", a name that more than one model "
"uses, so OpenCutter cannot tell which model it is and will not send anything "
"to it."
msgstr ""
"Esta máquina se identifica como «{model}», un nombre que usan varios "
"modelos, así que OpenCutter no puede saber qué modelo es y no le enviará "
"nada."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply} is not a unit reply (two numbers and a comma). Stopping before "
"anything is drawn.{report}"
msgstr ""
"U = {reply} no es una respuesta de unidad (dos números y una coma). Se "
"detiene antes de dibujar nada.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: not checked. The reply the {mat} gives on this model is not "
"known yet, so the cut area could not be checked."
msgstr ""
"U = {reply}: sin comprobar. Todavía no se conoce la respuesta que da el "
"{mat} en este modelo, así que no se pudo comprobar el área de corte."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: no reply is known for the {mat}, so the unit cannot be "
"confirmed. Stopping before anything is drawn."
msgstr ""
"U = {reply}: no se conoce ninguna respuesta para el {mat}, así que no se "
"puede confirmar la unidad. Se detiene antes de dibujar nada."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "U = {reply}: 0.05 mm per unit, confirmed"
msgstr "U = {reply}: 0.05 mm por unidad, confirmado"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: the unit looks like {size}, not 0.05 mm. Stopping before "
"anything is drawn.{report}"
msgstr ""
"U = {reply}: la unidad parece ser {size}, no 0.05 mm. Se detiene antes de "
"dibujar nada.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}, not {a},{b}: the mat type ({tg}) probably did not take effect "
"because the {mat} was not loaded right before the job. Unload and Load it on "
"the machine, then retry.{report}"
msgstr ""
"U = {reply}, no {a},{b}: probablemente el tipo de tapete ({tg}) no se aplicó "
"porque el {mat} no se cargó justo antes del trabajo. Descárguelo y cárguelo "
"en la máquina, y luego reinténtelo.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "{size} mat"
msgstr "tapete de {size}"

#: src/opencutter/device/protocol.py
msgid "mat"
msgstr "tapete"

#. Translators: added after a sentence: keep the space at the start.
#: src/opencutter/device/protocol.py
msgid ""
" The expected reply comes from the firmware analysis and was not measured on "
"this model yet: if the mat was loaded right before the job, please report "
"this reply."
msgstr ""
" La respuesta esperada procede del análisis del firmware y todavía no se ha "
"medido en este modelo: si el tapete se cargó justo antes del trabajo, "
"informe de esta respuesta."

#. Translators: added after a sentence: keep the space at the start.
#: src/opencutter/device/protocol.py
msgid ""
" If this happens again with the mat loaded right before the job, please "
"report it."
msgstr ""
" Si vuelve a ocurrir con el tapete cargado justo antes del trabajo, informe "
"de ello."

#: src/opencutter/job/plan.py
msgid "The mat may feed in and the carriage moves a little. The tool stays up."
msgstr ""
"Puede que el tapete avance un poco y que el carro se mueva ligeramente. La "
"herramienta se queda arriba."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The mat may feed in about {feed} mm and the carriage moves a little. The "
"tool stays up."
msgstr ""
"Puede que el tapete avance unos {feed} mm y que el carro se mueva "
"ligeramente. La herramienta se queda arriba."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "Header: {mat} cutting mat"
msgstr "Encabezado: tapete de corte {mat}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The machine should reply {a},{b}: {unit} mm per unit, mat command accepted."
msgstr ""
"La máquina debería responder {a},{b}: {unit} mm por unidad, orden de tapete "
"aceptada."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The reply is logged and shown but not checked: the {machine}'s reply with "
"the {mat} mat is not known, so the cut area could not be checked on this "
"model."
msgstr ""
"La respuesta se registra y se muestra, pero no se comprueba: no se conoce la "
"respuesta de la {machine} con el tapete de {mat}, así que no se pudo "
"comprobar el área de corte en este modelo."

#: src/opencutter/job/plan.py
msgid "Check units (no motion)"
msgstr "Comprobar unidades (sin movimiento)"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{holder}: {tool}, Force {force}, Speed {speed}"
msgstr "{holder}: {tool}, fuerza {force}, velocidad {speed}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"{holder}: {tool}, Blade Depth {depth} ({mm}), Force {force}, Speed {speed}"
msgstr ""
"{holder}: {tool}, profundidad de cuchilla {depth} ({mm}), fuerza {force}, "
"velocidad {speed}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{holder} is selected; the carriage may move. Nothing touches the media."
msgstr "Se selecciona la {holder}; el carro puede moverse. Nada toca la hoja."

#: src/opencutter/job/plan.py
msgid ""
"The tool settings are sent; the carriage may move. Nothing touches the media."
msgstr ""
"Se envían los ajustes de la herramienta; el carro puede moverse. Nada toca "
"la hoja."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"{holder} is selected; the carriage may move. Nothing touches the media. Then "
"the {tool} is set at its station on the left (about 10 s)."
msgstr ""
"Se selecciona la {holder}; el carro puede moverse. Nada toca la hoja. Luego "
"se ajusta la {tool} en su estación de la izquierda (unos 10 s)."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The tool settings are sent; the carriage may move. Nothing touches the "
"media. Then the {tool} is set at its station (about 10 s)."
msgstr ""
"Se envían los ajustes de la herramienta; el carro puede moverse. Nada toca "
"la hoja. Luego se ajusta la {tool} en su estación (unos 10 s)."

#: src/opencutter/job/plan.py
msgid "Preview outline (tool up)"
msgstr "Previsualizar el contorno (herramienta arriba)"

#: src/opencutter/job/plan.py
msgid ""
"The tool stays up and traces the outer box of the design. Check that it "
"stays over the media."
msgstr ""
"La herramienta se queda arriba y recorre el contorno exterior del diseño. "
"Compruebe que no se sale de la hoja."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: 1 path, {length} mm, {passes} passes."
msgstr "La herramienta baja: 1 trayecto, {length} mm, {passes} pasadas."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: {paths} paths, {length} mm, {passes} passes."
msgstr "La herramienta baja: {paths} trayectos, {length} mm, {passes} pasadas."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: 1 path, {length} mm."
msgstr "La herramienta baja: 1 trayecto, {length} mm."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: {paths} paths, {length} mm."
msgstr "La herramienta baja: {paths} trayectos, {length} mm."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{action} with {holder} ({tool})"
msgstr "{action} con la {holder} ({tool})"

