#: src/opencutter/gui/firstrun.py
msgid ""
"Switch your machine on. Some machines accept a Bluetooth connection only "
"right after they are switched on: if the app can’t connect, switch it off "
"and on."
msgstr ""
"Encienda la máquina. Algunas máquinas solo aceptan una conexión Bluetooth "
"justo después de encenderlas: si la aplicación no puede conectarse, apáguela "
"y vuelva a encenderla."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. It accepts a Bluetooth connection only right after "
"it is switched on: if the app can’t connect, switch it off and on."
msgstr ""
"Encienda la {machine}. Solo acepta una conexión Bluetooth justo después de "
"encenderla: si la aplicación no puede conectarse, apáguela y vuelva a "
"encenderla."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. If the app can’t connect, switch it off and on."
msgstr ""
"Encienda la {machine}. Si la aplicación no puede conectarse, apáguela y "
"vuelva a encenderla."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid "Switch the {machine} on. OpenCutter then connects to it by itself."
msgstr "Encienda la {machine}. OpenCutter se conectará a ella por sí solo."

#: src/opencutter/gui/firstrun.py
msgid "Welcome"
msgstr "Bienvenida"

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid "Step {step} of {steps}"
msgstr "Paso {step} de {steps}"

#: src/opencutter/gui/firstrun.py
msgid ""
"Draw in Inkscape, place the design on the mat here, choose Material, Action "
"and Tool, and send it over Bluetooth."
msgstr ""
"Dibuje en Inkscape, coloque aquí el diseño en el tapete, elija el material, "
"la acción y la herramienta, y envíelo por Bluetooth."

#: src/opencutter/gui/firstrun.py
