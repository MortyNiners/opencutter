#: src/opencutter/gui/jobview.py
msgid "Resuming…"
msgstr "Reanudando…"

#: src/opencutter/gui/jobview.py
#: src/opencutter/gui/runner.py
msgid "Pause"
msgstr "Pausar"

#: src/opencutter/gui/jobview.py
msgid "Pausing…"
msgstr "Pausando…"

#: src/opencutter/gui/jobview.py
msgid "Cancelling…"
msgstr "Cancelando…"

#: src/opencutter/gui/jobview.py
msgid ""
"Cancelling… A paused machine ends the job about 5 seconds after the stop."
msgstr ""
"Cancelando… Una máquina en pausa termina el trabajo unos 5 segundos después "
"de la parada."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid ""
"The machine still reports Paused {n} s after the stop. Press Unload on the "
"machine; if anything moves, press its power button."
msgstr ""
"La máquina sigue indicando En pausa {n} s después de la parada. Pulse "
"«Descargar» en la máquina; si algo se mueve, pulse su botón de encendido."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid "{step} progress"
msgstr "Progreso de {step}"

#: src/opencutter/gui/jobview.py
msgid "Is the outline in the right place?"
