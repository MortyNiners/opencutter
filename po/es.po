msgstr "{action} con la {tool}"

#: src/opencutter/job/plan.py
msgid "Return to Origin"
msgstr "Volver al origen"

#: src/opencutter/job/plan.py
msgid ""
"The tool moves up to the origin. The mat stays loaded; unload it on the "
"machine."
msgstr ""
"La herramienta vuelve al origen. El tapete sigue cargado; descárguelo en la "
"máquina."

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "OpenCutter cannot drive the {name} yet"
msgstr "OpenCutter todavía no puede controlar la {name}"

#: src/opencutter/job/validate.py
msgid "the job has nothing to cut"
msgstr "el trabajo no tiene nada que cortar"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "{holder} is used with two different tools"
msgstr "en la {holder} se usan dos herramientas distintas"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "the {name} has one tool holder, and the job uses two different tools"
msgstr ""
"la {name} tiene un solo portaherramientas, y el trabajo usa dos herramientas "
"distintas"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "more than {count} points"
msgstr "más de {count} puntos"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "the media does not fit on the {mat} cutting mat"
msgstr "la hoja no cabe en el tapete de corte {mat}"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "group {group}: point ({x}, {y}) mm lies outside the media"
msgstr "grupo {group}: el punto ({x}, {y}) mm queda fuera de la hoja"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "group {group}: point ({x}, {y}) mm lies outside the cut area"
msgstr "grupo {group}: el punto ({x}, {y}) mm queda fuera del área de corte"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "Blade Depth (TF) needs the {tool} detected in {holder}"
msgstr ""
"La profundidad de cuchilla (TF) necesita que la {tool} esté detectada en la "
"{holder}"

#: src/opencutter/machines/profile.py
#, python-brace-format
msgid "OpenCutter recognizes this {name} but cannot drive it yet: {reason}."
msgstr ""
"OpenCutter reconoce esta {name}, pero todavía no puede controlarla: {reason}."

#: src/opencutter/machines/recognized.py
msgid ""
"there is no known way to stop it from the computer, and it does not report "
"which tools are loaded"
msgstr ""
"no se conoce ninguna forma de detenerla desde el equipo y no indica qué "
"herramientas tiene colocadas"

#: src/opencutter/machines/recognized.py
msgid ""
"it needs a USB connection, which OpenCutter does not have, and there is no "
"known way to stop it from the computer"
msgstr ""
"necesita una conexión USB, que OpenCutter no tiene, y no se conoce ninguna "
"forma de detenerla desde el equipo"

#: src/opencutter/machines/recognized.py
msgid ""
"the work area of its trays, its tool height and the material thickness are "
"not known, and there is no way to confirm the work area before a cut"
msgstr ""
"no se conocen el área de trabajo de sus bandejas, la altura de su "
"herramienta ni el grosor del material, y no hay forma de confirmar el área "
"de trabajo antes de un corte"

