#: src/opencutter/gui/connection.py
msgid "Pair the machine once in <b>Settings → Bluetooth</b>."
msgstr "Один раз выполните сопряжение плоттера в <b>Параметры → Bluetooth</b>."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"The {name} accepts a Bluetooth connection only right after it is switched "
"on. If the app can’t connect, switch the machine off and on."
msgstr ""
"{name} принимает подключение по Bluetooth только сразу после включения. Если "
"приложению не удаётся подключиться, выключите и снова включите плоттер."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "If the app can’t connect to the {name}, switch the machine off and on."
msgstr ""
"Если приложению не удаётся подключиться к {name}, выключите и снова включите "
"плоттер."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"Make sure the {name} is switched on and paired. If it still fails, switch it "
"off and on again."
msgstr ""
"Убедитесь, что {name} включён и сопряжён. Если не получается, выключите и "
"снова включите его."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "Make sure the {name} is switched on and paired."
msgstr "Убедитесь, что {name} включён и сопряжён."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "Releases the {name} so other apps can connect to it."
msgstr "Освобождает {name}, чтобы к нему могли подключиться другие приложения."

#: src/opencutter/gui/connection.py
msgid "Available when the job has ended."
msgstr "Доступно после завершения задания."

#: src/opencutter/gui/connection.py
