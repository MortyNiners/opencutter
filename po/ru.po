msgstr "Оценка по плану, а не данные плоттера"

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid "{time} elapsed"
msgstr "Прошло {time}"

#: src/opencutter/gui/jobview.py
#, python-brace-format
