#: src/opencutter/gui/dialogs.py
msgid "A job is running"
msgstr "Выполняется задание"

#: src/opencutter/gui/dialogs.py
msgid "Cancel the job and quit? The machine stops right away."
msgstr "Отменить задание и выйти? Плоттер сразу остановится."

#: src/opencutter/gui/dialogs.py
msgid "Keep cutting"
msgstr "Продолжить резку"

#: src/opencutter/gui/dialogs.py
