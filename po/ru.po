#: src/opencutter/device/daemon.py
msgid "the machine is already paused"
msgstr "плоттер уже на паузе"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid "the machine is neither ready nor busy ({shown})"
msgstr "плоттер не готов и не занят ({shown})"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the machine is not answering (its status could not be read within {seconds} "
"s)"
msgstr ""
"плоттер не отвечает (не удалось прочитать его состояние за {seconds} с)"

#: src/opencutter/device/daemon.py
msgid "the machine is not answering (no reply to ESC 05)"
msgstr "плоттер не отвечает (нет ответа на ESC 05)"

#: src/opencutter/device/daemon.py
msgid ""
"the machine's status could not be read for sure (an earlier reply is still "
"due); try again"
msgstr ""
"не удалось надёжно прочитать состояние плоттера (ещё ожидается ответ на "
"предыдущий запрос); повторите попытку"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the resume write failed ({error}); whether it arrived is unknown, and it is "
"not sent again"
msgstr ""
"ошибка записи команды «Продолжить» ({error}); неизвестно, дошла ли она до "
"плоттера, и повторно она не отправляется"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the pause write failed ({error}); whether it arrived is unknown, and it is "
"not sent again"
msgstr ""
"ошибка записи команды «Пауза» ({error}); неизвестно, дошла ли она до "
"плоттера, и повторно она не отправляется"

#: src/opencutter/device/protocol.py
msgid ""
"Do not press Pause to continue: press Unload on the machine (or switch it "
"off and on), check that the tool is up, then load the Cutting Mat right "
"before the job."
msgstr ""
"Не нажимайте паузу, чтобы продолжить: нажмите «Выгрузить» на плоттере (или "
"выключите и снова включите его), убедитесь, что инструмент поднят, затем "
"загрузите коврик непосредственно перед заданием."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is busy ({shown}): it is still working, or another connection "
"such as USB holds it. Nothing was sent. Wait until it shows Ready, then try "
"again."
msgstr ""
"Плоттер занят ({shown}): он ещё работает, или его удерживает другое "
"подключение, например USB. Ничего не отправлено. Подождите, пока он покажет "
"«Готов», и повторите попытку."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "The machine is paused ({shown}). Nothing was sent. {advice}"
msgstr "Плоттер на паузе ({shown}). Ничего не отправлено. {advice}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is still ending a cancel ({shown}). Nothing was sent. Wait until "
"it shows Ready or Load Media. {advice}"
msgstr ""
"Плоттер ещё завершает отмену ({shown}). Ничего не отправлено. Подождите, "
"пока он покажет «Готов» или «Ждёт загрузки». {advice}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine rejected a command ({shown}): another connection, such as USB, "
"held it. Nothing was sent. Close the other connection, then try again."
msgstr ""
"Плоттер отклонил команду ({shown}): его удерживало другое подключение, "
"например USB. Ничего не отправлено. Закройте другое подключение и повторите "
"попытку."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is not ready ({shown}). Load the Cutting Mat on the machine "
"right before the job."
msgstr ""
"Плоттер не готов ({shown}). Загрузите коврик на плоттере непосредственно "
"перед заданием."

#: src/opencutter/device/protocol.py
msgid ""
"This machine did not report its model. OpenCutter cannot drive it and will "
"not send anything to it."
msgstr ""
"Этот плоттер не сообщил свою модель. OpenCutter не умеет им управлять и "
"ничего не будет ему отправлять."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"This machine reports itself as \"{model}\". OpenCutter cannot drive it and "
"will not send anything to it."
msgstr ""
"Этот плоттер называет себя «{model}». OpenCutter не умеет им управлять и "
"ничего не будет ему отправлять."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"This machine reports itself as \"{model}\", a name that more than one model "
"uses, so OpenCutter cannot tell which model it is and will not send anything "
"to it."
msgstr ""
"Этот плоттер называет себя «{model}», но это имя носят несколько моделей, "
"поэтому OpenCutter не может определить модель и ничего не будет ему "
"отправлять."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply} is not a unit reply (two numbers and a comma). Stopping before "
"anything is drawn.{report}"
msgstr ""
"U = {reply} — это не ответ с единицей измерения (два числа через запятую). "
"Остановка до начала рисования.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: not checked. The reply the {mat} gives on this model is not "
"known yet, so the cut area could not be checked."
msgstr ""
"U = {reply}: не проверено. Какой ответ даёт {mat} на этой модели, пока "
"неизвестно, поэтому область резки проверить не удалось."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: no reply is known for the {mat}, so the unit cannot be "
"confirmed. Stopping before anything is drawn."
msgstr ""
"U = {reply}: ожидаемый ответ неизвестен ({mat}), поэтому единицу измерения "
"подтвердить нельзя. Остановка до начала рисования."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "U = {reply}: 0.05 mm per unit, confirmed"
msgstr "U = {reply}: 0.05 mm на единицу, подтверждено"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: the unit looks like {size}, not 0.05 mm. Stopping before "
"anything is drawn.{report}"
msgstr ""
"U = {reply}: единица похожа на {size}, а не на 0.05 mm. Остановка до начала "
"рисования.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}, not {a},{b}: the mat type ({tg}) probably did not take effect "
"because the {mat} was not loaded right before the job. Unload and Load it on "
"the machine, then retry.{report}"
msgstr ""
"U = {reply}, а не {a},{b}: тип коврика ({tg}), вероятно, не применился, "
"потому что {mat} не был загружен непосредственно перед заданием. Выгрузите и "
"загрузите его на плоттере, затем повторите.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "{size} mat"
msgstr "коврик {size}"

#: src/opencutter/device/protocol.py
msgid "mat"
msgstr "коврик"

#. Translators: added after a sentence: keep the space at the start.
#: src/opencutter/device/protocol.py
msgid ""
" The expected reply comes from the firmware analysis and was not measured on "
"this model yet: if the mat was loaded right before the job, please report "
"this reply."
msgstr ""
" Ожидаемый ответ взят из анализа прошивки и на этой модели ещё не измерялся: "
"если коврик был загружен непосредственно перед заданием, пожалуйста, "
"сообщите об этом ответе."

#. Translators: added after a sentence: keep the space at the start.
#: src/opencutter/device/protocol.py
msgid ""
" If this happens again with the mat loaded right before the job, please "
"report it."
msgstr ""
" Если это повторится, когда коврик загружен непосредственно перед заданием, "
"пожалуйста, сообщите об этом."

#: src/opencutter/job/plan.py
msgid "The mat may feed in and the carriage moves a little. The tool stays up."
msgstr ""
"Коврик может подаваться внутрь, каретка немного сдвигается. Инструмент "
"остаётся поднятым."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The mat may feed in about {feed} mm and the carriage moves a little. The "
"tool stays up."
msgstr ""
"Коврик может подаваться внутрь примерно на {feed} mm, каретка немного "
"сдвигается. Инструмент остаётся поднятым."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "Header: {mat} cutting mat"
msgstr "Заголовок: коврик {mat}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The machine should reply {a},{b}: {unit} mm per unit, mat command accepted."
msgstr ""
"Плоттер должен ответить {a},{b}: {unit} mm на единицу, команда коврика "
"принята."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The reply is logged and shown but not checked: the {machine}'s reply with "
"the {mat} mat is not known, so the cut area could not be checked on this "
"model."
msgstr ""
"Ответ записывается в журнал и показывается, но не проверяется: ответ "
"{machine} с ковриком {mat} неизвестен, поэтому область резки на этой модели "
"проверить не удалось."

#: src/opencutter/job/plan.py
msgid "Check units (no motion)"
msgstr "Проверка единиц (без движения)"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{holder}: {tool}, Force {force}, Speed {speed}"
msgstr "{holder}: {tool}, нажим {force}, скорость {speed}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"{holder}: {tool}, Blade Depth {depth} ({mm}), Force {force}, Speed {speed}"
msgstr ""
"{holder}: {tool}, глубина лезвия {depth} ({mm}), нажим {force}, скорость "
"{speed}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{holder} is selected; the carriage may move. Nothing touches the media."
msgstr "Выбран {holder}; каретка может сдвинуться. Ничто не касается листа."

#: src/opencutter/job/plan.py
msgid ""
"The tool settings are sent; the carriage may move. Nothing touches the media."
msgstr ""
"Настройки инструмента отправлены; каретка может сдвинуться. Ничто не "
"касается листа."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"{holder} is selected; the carriage may move. Nothing touches the media. Then "
"the {tool} is set at its station on the left (about 10 s)."
msgstr ""
"Выбран {holder}; каретка может сдвинуться. Ничто не касается листа. Затем "
"{tool} настраивается на своей станции слева (около 10 с)."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The tool settings are sent; the carriage may move. Nothing touches the "
"media. Then the {tool} is set at its station (about 10 s)."
msgstr ""
"Настройки инструмента отправлены; каретка может сдвинуться. Ничто не "
"касается листа. Затем {tool} настраивается на своей станции (около 10 с)."

#: src/opencutter/job/plan.py
msgid "Preview outline (tool up)"
msgstr "Обвод контура (инструмент поднят)"

#: src/opencutter/job/plan.py
msgid ""
"The tool stays up and traces the outer box of the design. Check that it "
"stays over the media."
msgstr ""
"Инструмент остаётся поднятым и обводит внешнюю рамку макета. Убедитесь, что "
"он не выходит за пределы листа."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: 1 path, {length} mm, {passes} passes."
msgstr "Инструмент опускается (1 контур, {length} mm, проходов: {passes})."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: {paths} paths, {length} mm, {passes} passes."
msgstr ""
"Инструмент опускается (контуров: {paths}, {length} mm, проходов: {passes})."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: 1 path, {length} mm."
msgstr "Инструмент опускается (1 контур, {length} mm)."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: {paths} paths, {length} mm."
msgstr "Инструмент опускается (контуров: {paths}, {length} mm)."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{action} with {holder} ({tool})"
msgstr "{action}: {holder} ({tool})"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{action} with the {tool}"
msgstr "{action}: {tool}"

#: src/opencutter/job/plan.py
msgid "Return to Origin"
msgstr "Возврат в начало"

#: src/opencutter/job/plan.py
msgid ""
"The tool moves up to the origin. The mat stays loaded; unload it on the "
"machine."
msgstr ""
"Инструмент возвращается к началу координат. Коврик остаётся загруженным; "
"выгрузите его на плоттере."

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "OpenCutter cannot drive the {name} yet"
msgstr "OpenCutter пока не умеет управлять {name}"

#: src/opencutter/job/validate.py
msgid "the job has nothing to cut"
msgstr "в задании нечего резать"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "{holder} is used with two different tools"
msgstr "{holder} используется с двумя разными инструментами"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "the {name} has one tool holder, and the job uses two different tools"
msgstr ""
"у {name} один держатель, а в задании используются два разных инструмента"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "more than {count} points"
msgstr "число точек больше {count}"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "the media does not fit on the {mat} cutting mat"
msgstr "лист не помещается на коврике {mat}"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "group {group}: point ({x}, {y}) mm lies outside the media"
msgstr "группа {group}: точка ({x}, {y}) mm лежит за пределами листа"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "group {group}: point ({x}, {y}) mm lies outside the cut area"
msgstr "группа {group}: точка ({x}, {y}) mm лежит за пределами области резки"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "Blade Depth (TF) needs the {tool} detected in {holder}"
msgstr ""
"для глубины лезвия (TF) нужно, чтобы в {holder} был обнаружен инструмент "
"«{tool}»"

#: src/opencutter/machines/profile.py
#, python-brace-format
msgid "OpenCutter recognizes this {name} but cannot drive it yet: {reason}."
msgstr ""
"OpenCutter распознаёт этот {name}, но пока не умеет им управлять: {reason}."

#: src/opencutter/machines/recognized.py
msgid ""
"there is no known way to stop it from the computer, and it does not report "
"which tools are loaded"
msgstr ""
"неизвестно, как остановить его с компьютера, и он не сообщает, какие "
"инструменты установлены"

#: src/opencutter/machines/recognized.py
msgid ""
"it needs a USB connection, which OpenCutter does not have, and there is no "
"known way to stop it from the computer"
msgstr ""
"ему нужно подключение по USB, которого в OpenCutter нет, и неизвестно, как "
"остановить его с компьютера"

#: src/opencutter/machines/recognized.py
msgid ""
"the work area of its trays, its tool height and the material thickness are "
"not known, and there is no way to confirm the work area before a cut"
msgstr ""
"неизвестны рабочая область его лотков, высота инструмента и толщина "
"материала, и нет способа подтвердить рабочую область перед резкой"

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: the file is damaged or not an SVG ({error})."
msgstr ""
"Не удалось прочитать {name}: файл повреждён или не является SVG ({error})."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: it is not an SVG file."
msgstr "Не удалось прочитать {name}: это не SVG-файл."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: {error}"
msgstr "Не удалось прочитать {name}: {error}"

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Nothing to cut in {name}: it has no visible paths or shapes."
msgstr "В {name} нечего резать: нет видимых контуров или фигур."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} text object ignored: convert text to paths in Inkscape (Path > Object to "
"Path)."
msgid_plural ""
"{n} text objects ignored: convert text to paths in Inkscape (Path > Object "
"to Path)."
msgstr[0] ""
"{n} текстовый объект пропущен: преобразуйте текст в контуры в Inkscape "
"(Контур > Оконтурить объект)."
msgstr[1] ""
"{n} текстовых объекта пропущено: преобразуйте текст в контуры в Inkscape "
"(Контур > Оконтурить объект)."
msgstr[2] ""
"{n} текстовых объектов пропущено: преобразуйте текст в контуры в Inkscape "
"(Контур > Оконтурить объект)."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} image ignored: trace images in Inkscape (Path > Trace Bitmap) to cut "
"them."
msgid_plural ""
"{n} images ignored: trace images in Inkscape (Path > Trace Bitmap) to cut "
"them."
msgstr[0] ""
"{n} изображение пропущено: чтобы вырезать изображения, векторизуйте их в "
"Inkscape (Контур > Векторизовать растр)."
msgstr[1] ""
"{n} изображения пропущено: чтобы вырезать изображения, векторизуйте их в "
"Inkscape (Контур > Векторизовать растр)."
msgstr[2] ""
"{n} изображений пропущено: чтобы вырезать изображения, векторизуйте их в "
"Inkscape (Контур > Векторизовать растр)."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} clipped or masked object: clips and masks are ignored, so the whole "
"object is cut."
msgid_plural ""
"{n} clipped or masked objects: clips and masks are ignored, so the whole "
"object is cut."
msgstr[0] ""
"{n} объект с обтравкой или маской: обтравочные контуры и маски игнорируются, "
"поэтому вырезается весь объект."
msgstr[1] ""
"{n} объекта с обтравкой или маской: обтравочные контуры и маски "
"игнорируются, поэтому вырезаются объекты целиком."
msgstr[2] ""
"{n} объектов с обтравкой или маской: обтравочные контуры и маски "
"игнорируются, поэтому вырезаются объекты целиком."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not open {name}: {error}."
msgstr "Не удалось открыть {name}: {error}."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: the compressed file is damaged."
msgstr "Не удалось прочитать {name}: сжатый файл повреждён."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: the file is too large."
msgstr "Не удалось прочитать {name}: файл слишком большой."
