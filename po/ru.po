msgstr "По левому краю"

#: src/opencutter/gui/geometry.py
msgid "Align Center"
msgstr "По центру по горизонтали"

#: src/opencutter/gui/geometry.py
msgid "Align Right"
msgstr "По правому краю"

#: src/opencutter/gui/geometry.py
msgid "Align Top"
