#, python-brace-format
msgid "{action} stopped"
msgstr "{action}: остановлено"

#: src/opencutter/gui/jobview.py
msgid "Job cancelled"
msgstr "Задание отменено"

#: src/opencutter/gui/jobview.py
#: src/opencutter/gui/window.py
msgid "Connection lost"
msgstr "Связь потеряна"

#: src/opencutter/gui/jobview.py
#: src/opencutter/gui/sheets.py
#: src/opencutter/gui/sidebar.py
msgid "Material"
msgstr "Материал"

#: src/opencutter/gui/jobview.py
