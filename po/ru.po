msgstr "Этапы задания"

#: src/opencutter/gui/jobview.py
msgid ""
"Pause the machine: it finishes the few moves it has planned, lifts the tool "
"and waits"
msgstr ""
"Приостановить плоттер: он закончит несколько уже запланированных движений, "
"поднимет инструмент и будет ждать"

#: src/opencutter/gui/jobview.py
#: src/opencutter/gui/window.py
msgid "Cancel Job"
msgstr "Отменить"

#. Translators: the Escape key, as printed on keyboards.
#: src/opencutter/gui/jobview.py
msgctxt "key"
