msgstr "С этим ковриком на этой модели область резки пока нельзя проверить."

#: src/opencutter/gui/geometry.py
msgctxt "paper size"
msgid "Letter"
msgstr "Letter"

#: src/opencutter/gui/geometry.py
#: src/opencutter/gui/window.py
