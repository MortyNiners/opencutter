#: src/opencutter/gui/window.py
msgid "Connection lost during the job"
msgstr "Connessione persa durante il lavoro"

#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid ""
"OpenCutter cannot stop the machine without the connection. If it is still "
"moving, press its power button. Then switch it on again to reconnect."
msgstr ""
"Senza connessione OpenCutter non può fermare la macchina. Se si sta ancora "
"muovendo, premi il suo pulsante di accensione. Poi riaccendila per "
"riconnetterti."

#: src/opencutter/gui/dialogs.py
msgid "Close"
msgstr "Chiudi"

#: src/opencutter/gui/dialogs.py
msgid "Reconnect"
msgstr "Riconnetti"

#: src/opencutter/gui/dialogs.py
msgid "The stop could not be sent"
msgstr "Impossibile inviare il comando di arresto"

#: src/opencutter/gui/dialogs.py
msgid ""
"Press the machine's power button now. The window stays open; close it again "
"once the machine has stopped."
msgstr ""
"Premi ora il pulsante di accensione della macchina. La finestra resta "
"aperta; chiudila di nuovo quando la macchina si è fermata."

#: src/opencutter/gui/dialogs.py
msgid "OK"
msgstr "OK"

#: src/opencutter/gui/dialogs.py
msgid ""
"OpenCutter could not send the stop to the machine. If it moves, press its "
"power button now."
msgstr ""
"OpenCutter non è riuscito a inviare il comando di arresto alla macchina. Se "
"si muove, premi subito il suo pulsante di accensione."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Busy"
msgstr "La macchina risulta ancora occupata"

#: src/opencutter/gui/dialogs.py
msgid ""
"The stop was sent, but the machine still reports Busy. If it moves, press "
"its power button now."
msgstr ""
"Il comando di arresto è stato inviato, ma la macchina risulta ancora "
"occupata. Se si muove, premi subito il suo pulsante di accensione."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Paused"
msgstr "La macchina risulta ancora in pausa"

