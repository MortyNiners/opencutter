#: src/opencutter/gui/firstrun.py
msgid ""
"Switch your machine on. Some machines accept a Bluetooth connection only "
"right after they are switched on: if the app can’t connect, switch it off "
"and on."
msgstr ""
"Accendi la macchina. Alcune macchine accettano una connessione Bluetooth "
"solo subito dopo l’accensione: se l’app non riesce a connettersi, spegnila e "
"riaccendila."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. It accepts a Bluetooth connection only right after "
"it is switched on: if the app can’t connect, switch it off and on."
msgstr ""
"Accendi la {machine}. Accetta una connessione Bluetooth solo subito dopo "
"l’accensione: se l’app non riesce a connettersi, spegnila e riaccendila."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. If the app can’t connect, switch it off and on."
msgstr ""
"Accendi la {machine}. Se l’app non riesce a connettersi, spegnila e "
"riaccendila."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid "Switch the {machine} on. OpenCutter then connects to it by itself."
msgstr "Accendi la {machine}. OpenCutter si connette da solo."

#: src/opencutter/gui/firstrun.py
msgid "Welcome"
msgstr "Benvenuto"

#: src/opencutter/gui/firstrun.py
#, python-brace-format
