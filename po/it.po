#: src/opencutter/gui/dialogs.py
msgid "A job is running"
msgstr "Un lavoro è in corso"

#: src/opencutter/gui/dialogs.py
msgid "Cancel the job and quit? The machine stops right away."
msgstr "Annullare il lavoro e uscire? La macchina si ferma subito."

#: src/opencutter/gui/dialogs.py
msgid "Keep cutting"
msgstr "Continua a tagliare"

#: src/opencutter/gui/dialogs.py
