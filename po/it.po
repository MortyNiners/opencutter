msgstr "Riprendi"

#: src/opencutter/gui/jobview.py
msgid "Resuming…"
msgstr "Ripresa…"

#: src/opencutter/gui/jobview.py
#: src/opencutter/gui/runner.py
msgid "Pause"
msgstr "Pausa"

#: src/opencutter/gui/jobview.py
msgid "Pausing…"
msgstr "Messa in pausa…"

#: src/opencutter/gui/jobview.py
msgid "Cancelling…"
msgstr "Annullamento…"

#: src/opencutter/gui/jobview.py
msgid ""
"Cancelling… A paused machine ends the job about 5 seconds after the stop."
msgstr ""
"Annullamento… Una macchina in pausa termina il lavoro circa 5 secondi dopo "
"l’arresto."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid ""
"The machine still reports Paused {n} s after the stop. Press Unload on the "
"machine; if anything moves, press its power button."
msgstr ""
"La macchina risulta ancora in pausa {n} s dopo l’arresto. Premi Scarica "
"sulla macchina; se qualcosa si muove, premi il suo pulsante di accensione."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid "{step} progress"
msgstr "Avanzamento: {step}"

#: src/opencutter/gui/jobview.py
msgid "Is the outline in the right place?"
