#: src/opencutter/gui/connection.py
msgid "Pair the machine once in <b>Settings → Bluetooth</b>."
msgstr "Associa la macchina una volta in <b>Impostazioni → Bluetooth</b>."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"The {name} accepts a Bluetooth connection only right after it is switched "
"on. If the app can’t connect, switch the machine off and on."
msgstr ""
"La {name} accetta una connessione Bluetooth solo subito dopo l’accensione. "
"Se l’app non riesce a connettersi, spegni e riaccendi la macchina."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "If the app can’t connect to the {name}, switch the machine off and on."
msgstr ""
"Se l’app non riesce a connettersi alla {name}, spegni e riaccendi la "
"macchina."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"Make sure the {name} is switched on and paired. If it still fails, switch it "
"off and on again."
msgstr ""
"Assicurati che la {name} sia accesa e associata. Se non funziona ancora, "
"spegnila e riaccendila."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "Make sure the {name} is switched on and paired."
msgstr "Assicurati che la {name} sia accesa e associata."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "Releases the {name} so other apps can connect to it."
msgstr "Libera la {name} così che altre app possano connettersi."

#: src/opencutter/gui/connection.py
msgid "Available when the job has ended."
msgstr "Disponibile quando il lavoro è finito."

#: src/opencutter/gui/connection.py
