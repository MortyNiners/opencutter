#: src/opencutter/gui/window.py
msgid "Waiting for the machine to confirm the stop…"
msgstr "Esperando que a máquina confirme que parou…"

#: src/opencutter/gui/window.py
#, python-brace-format
msgid ""
"A stop could not get through to the {name}. OpenCutter sends it as soon as "
"the {name} is connected again. If it moves, press its power button."
msgstr ""
"Um comando de parar não conseguiu chegar à {name}. O OpenCutter envia-o "
"assim que a {name} voltar a estar conectada. Se ela se mexer, pressione o "
"botão de ligar/desligar."

#: src/opencutter/gui/window.py
#, python-brace-format
msgid ""
"The stop that could not get through was sent to the {name} when it connected "
"again."
msgstr ""
"O comando de parar que não tinha conseguido chegar foi enviado à {name} "
"quando ela voltou a conectar."

