#: src/opencutter/gui/connection.py
msgid "Pair the machine once in <b>Settings → Bluetooth</b>."
msgstr "Emparelhe a máquina uma vez em <b>Configurações → Bluetooth</b>."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"The {name} accepts a Bluetooth connection only right after it is switched "
"on. If the app can’t connect, switch the machine off and on."
msgstr ""
"A {name} só aceita uma conexão Bluetooth logo depois de ser ligada. Se o "
"OpenCutter não conseguir conectar, desligue e volte a ligar a máquina."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "If the app can’t connect to the {name}, switch the machine off and on."
msgstr ""
"Se o OpenCutter não conseguir conectar à {name}, desligue e volte a ligar a "
"máquina."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"Make sure the {name} is switched on and paired. If it still fails, switch it "
"off and on again."
msgstr ""
"Verifique se a {name} está ligada e emparelhada. Se ainda assim falhar, "
"desligue-a e volte a ligá-la."

#: src/opencutter/gui/connection.py
#, python-brace-format
