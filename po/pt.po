#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid ""
"OpenCutter cannot stop the machine without the connection. If it is still "
"moving, press its power button. Then switch it on again to reconnect."
msgstr ""
"O OpenCutter não consegue parar a máquina sem a conexão. Se ela ainda se "
"mexer, pressione o botão de ligar/desligar da máquina. Depois ligue-a de "
"novo para voltar a conectar."

#: src/opencutter/gui/dialogs.py
msgid "Close"
msgstr "Fechar"

#: src/opencutter/gui/dialogs.py
msgid "Reconnect"
msgstr "Reconectar"

#: src/opencutter/gui/dialogs.py
msgid "The stop could not be sent"
msgstr "Não foi possível enviar o comando de parar"

#: src/opencutter/gui/dialogs.py
msgid ""
"Press the machine's power button now. The window stays open; close it again "
"once the machine has stopped."
msgstr ""
"Pressione agora o botão de ligar/desligar da máquina. A janela fica aberta; "
"feche-a de novo quando a máquina tiver parado."

#: src/opencutter/gui/dialogs.py
msgid "OK"
msgstr "OK"

#: src/opencutter/gui/dialogs.py
msgid ""
"OpenCutter could not send the stop to the machine. If it moves, press its "
"power button now."
msgstr ""
"O OpenCutter não conseguiu enviar o comando de parar à máquina. Se ela se "
"mexer, pressione agora o botão de ligar/desligar."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Busy"
msgstr "A máquina ainda indica Ocupada"

#: src/opencutter/gui/dialogs.py
msgid ""
"The stop was sent, but the machine still reports Busy. If it moves, press "
"its power button now."
msgstr ""
"O comando de parar foi enviado, mas a máquina ainda indica Ocupada. Se ela "
"se mexer, pressione agora o botão de ligar/desligar."

#: src/opencutter/gui/dialogs.py
