msgstr ""
"não foi possível ler com certeza o estado da máquina (ainda falta uma "
"resposta anterior); tente de novo"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the resume write failed ({error}); whether it arrived is unknown, and it is "
"not sent again"
msgstr ""
"o envio do comando Retomar falhou ({error}); não se sabe se ele chegou, e "
"não é enviado de novo"

#: src/opencutter/device/daemon.py
#, python-brace-format
msgid ""
"the pause write failed ({error}); whether it arrived is unknown, and it is "
"not sent again"
msgstr ""
"o envio do comando Pausar falhou ({error}); não se sabe se ele chegou, e não "
"é enviado de novo"

#: src/opencutter/device/protocol.py
msgid ""
"Do not press Pause to continue: press Unload on the machine (or switch it "
"off and on), check that the tool is up, then load the Cutting Mat right "
"before the job."
msgstr ""
"Não pressione Pausa para continuar: pressione Descarregar na máquina (ou "
"desligue-a e volte a ligá-la), verifique se a ferramenta está levantada e "
"depois carregue a base de corte logo antes do trabalho."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is busy ({shown}): it is still working, or another connection "
"such as USB holds it. Nothing was sent. Wait until it shows Ready, then try "
"again."
msgstr ""
"A máquina está ocupada ({shown}): ainda tem trabalho em curso, ou está "
"ocupada por outra conexão, como USB. Nada foi enviado. Aguarde até ela "
"mostrar Pronta e depois tente de novo."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "The machine is paused ({shown}). Nothing was sent. {advice}"
msgstr "A máquina está em pausa ({shown}). Nada foi enviado. {advice}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is still ending a cancel ({shown}). Nothing was sent. Wait until "
"it shows Ready or Load Media. {advice}"
msgstr ""
"A máquina ainda não terminou um cancelamento ({shown}). Nada foi enviado. "
"Aguarde até ela mostrar Pronta ou Carregar base. {advice}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine rejected a command ({shown}): another connection, such as USB, "
"held it. Nothing was sent. Close the other connection, then try again."
msgstr ""
"A máquina recusou um comando ({shown}): estava ocupada por outra conexão, "
"como USB. Nada foi enviado. Feche a outra conexão e depois tente de novo."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"The machine is not ready ({shown}). Load the Cutting Mat on the machine "
"right before the job."
msgstr ""
"A máquina não está pronta ({shown}). Carregue a base de corte na máquina "
"logo antes do trabalho."

#: src/opencutter/device/protocol.py
msgid ""
"This machine did not report its model. OpenCutter cannot drive it and will "
"not send anything to it."
msgstr ""
"Esta máquina não indicou o seu modelo. O OpenCutter não consegue controlá-la "
"e não vai enviar nada para ela."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"This machine reports itself as \"{model}\". OpenCutter cannot drive it and "
"will not send anything to it."
msgstr ""
"Esta máquina diz ser “{model}”. O OpenCutter não consegue controlá-la e não "
"vai enviar nada para ela."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"This machine reports itself as \"{model}\", a name that more than one model "
"uses, so OpenCutter cannot tell which model it is and will not send anything "
"to it."
msgstr ""
"Esta máquina diz ser “{model}”, um nome usado por mais de um modelo, por "
"isso o OpenCutter não consegue saber qual é o modelo e não vai enviar nada "
"para ela."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply} is not a unit reply (two numbers and a comma). Stopping before "
"anything is drawn.{report}"
msgstr ""
"U = {reply} não é uma resposta de unidade (dois números e uma vírgula). "
"Parando antes de desenhar qualquer coisa.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: not checked. The reply the {mat} gives on this model is not "
"known yet, so the cut area could not be checked."
msgstr ""
"U = {reply}: não verificado. A resposta da {mat} neste modelo ainda não é "
"conhecida, por isso não foi possível verificar a área de corte."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: no reply is known for the {mat}, so the unit cannot be "
"confirmed. Stopping before anything is drawn."
msgstr ""
"U = {reply}: não se conhece resposta para a {mat}, por isso a unidade não "
"pode ser confirmada. Parando antes de desenhar qualquer coisa."

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "U = {reply}: 0.05 mm per unit, confirmed"
msgstr "U = {reply}: 0.05 mm por unidade, confirmado"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}: the unit looks like {size}, not 0.05 mm. Stopping before "
"anything is drawn.{report}"
msgstr ""
"U = {reply}: a unidade parece ser {size}, não 0.05 mm. Parando antes de "
"desenhar qualquer coisa.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid ""
"U = {reply}, not {a},{b}: the mat type ({tg}) probably did not take effect "
"because the {mat} was not loaded right before the job. Unload and Load it on "
"the machine, then retry.{report}"
msgstr ""
"U = {reply}, não {a},{b}: o tipo de base ({tg}) provavelmente não teve "
"efeito porque a {mat} não foi carregada logo antes do trabalho. "
"Descarregue-a e carregue-a na máquina e depois tente de novo.{report}"

#: src/opencutter/device/protocol.py
#, python-brace-format
msgid "{size} mat"
msgstr "base {size}"

#: src/opencutter/device/protocol.py
msgid "mat"
msgstr "base"

#. Translators: added after a sentence: keep the space at the start.
#: src/opencutter/device/protocol.py
msgid ""
" The expected reply comes from the firmware analysis and was not measured on "
"this model yet: if the mat was loaded right before the job, please report "
"this reply."
msgstr ""
" A resposta esperada vem da análise do firmware e ainda não foi medida neste "
"modelo: se a base foi carregada logo antes do trabalho, por favor comunique "
"esta resposta."

#. Translators: added after a sentence: keep the space at the start.
#: src/opencutter/device/protocol.py
msgid ""
" If this happens again with the mat loaded right before the job, please "
"report it."
msgstr ""
" Se isto voltar a acontecer com a base carregada logo antes do trabalho, por "
"favor comunique-o."

#: src/opencutter/job/plan.py
msgid "The mat may feed in and the carriage moves a little. The tool stays up."
msgstr ""
"A base pode entrar e o carro faz um pequeno movimento. A ferramenta fica "
"levantada."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The mat may feed in about {feed} mm and the carriage moves a little. The "
"tool stays up."
msgstr ""
"A base pode entrar cerca de {feed} mm e o carro faz um pequeno movimento. A "
"ferramenta fica levantada."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "Header: {mat} cutting mat"
msgstr "Cabeçalho: base de corte {mat}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The machine should reply {a},{b}: {unit} mm per unit, mat command accepted."
msgstr ""
"A máquina deve responder {a},{b}: {unit} mm por unidade, comando da base "
"confirmado."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The reply is logged and shown but not checked: the {machine}'s reply with "
"the {mat} mat is not known, so the cut area could not be checked on this "
"model."
msgstr ""
"A resposta é mostrada e fica no histórico, mas não é verificada: a resposta "
"da {machine} com a base {mat} não é conhecida, por isso não foi possível "
"verificar a área de corte neste modelo."

#: src/opencutter/job/plan.py
