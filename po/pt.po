msgstr "Verificar unidades (sem movimento)"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{holder}: {tool}, Force {force}, Speed {speed}"
msgstr "{holder}: {tool}, Força {force}, Velocidade {speed}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"{holder}: {tool}, Blade Depth {depth} ({mm}), Force {force}, Speed {speed}"
msgstr ""
"{holder}: {tool}, Profundidade da lâmina {depth} ({mm}), Força {force}, "
"Velocidade {speed}"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{holder} is selected; the carriage may move. Nothing touches the media."
msgstr "A {holder} é selecionada; o carro pode mover-se. Nada toca a folha."

#: src/opencutter/job/plan.py
msgid ""
"The tool settings are sent; the carriage may move. Nothing touches the media."
msgstr ""
"As configurações da ferramenta são enviadas; o carro pode mover-se. Nada "
"toca a folha."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"{holder} is selected; the carriage may move. Nothing touches the media. Then "
"the {tool} is set at its station on the left (about 10 s)."
msgstr ""
"A {holder} é selecionada; o carro pode mover-se. Nada toca a folha. Depois a "
"{tool} é regulada na sua estação, à esquerda (cerca de 10 s)."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid ""
"The tool settings are sent; the carriage may move. Nothing touches the "
"media. Then the {tool} is set at its station (about 10 s)."
msgstr ""
"As configurações da ferramenta são enviadas; o carro pode mover-se. Nada "
"toca a folha. Depois a {tool} é regulada na sua estação (cerca de 10 s)."

#: src/opencutter/job/plan.py
msgid "Preview outline (tool up)"
msgstr "Pré-visualizar contorno (ferramenta levantada)"

#: src/opencutter/job/plan.py
msgid ""
"The tool stays up and traces the outer box of the design. Check that it "
"stays over the media."
msgstr ""
"A ferramenta fica levantada e percorre o contorno exterior do projeto. "
"Verifique se ela fica por cima da folha."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: 1 path, {length} mm, {passes} passes."
msgstr "A ferramenta desce: 1 caminho, {length} mm, {passes} passagens."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: {paths} paths, {length} mm, {passes} passes."
msgstr "A ferramenta desce: {paths} caminhos, {length} mm, {passes} passagens."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: 1 path, {length} mm."
msgstr "A ferramenta desce: 1 caminho, {length} mm."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "The tool goes down: {paths} paths, {length} mm."
msgstr "A ferramenta desce: {paths} caminhos, {length} mm."

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{action} with {holder} ({tool})"
msgstr "{action} com a {holder} ({tool})"

#: src/opencutter/job/plan.py
#, python-brace-format
msgid "{action} with the {tool}"
msgstr "{action} com a {tool}"

#: src/opencutter/job/plan.py
msgid "Return to Origin"
msgstr "Voltar à origem"

#: src/opencutter/job/plan.py
msgid ""
"The tool moves up to the origin. The mat stays loaded; unload it on the "
"machine."
msgstr ""
"A ferramenta volta à origem. A base fica carregada; descarregue-a na máquina."

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "OpenCutter cannot drive the {name} yet"
msgstr "O OpenCutter ainda não consegue controlar a {name}"

#: src/opencutter/job/validate.py
msgid "the job has nothing to cut"
msgstr "o trabalho não tem nada para cortar"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "{holder} is used with two different tools"
msgstr "a {holder} é usada com duas ferramentas diferentes"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "the {name} has one tool holder, and the job uses two different tools"
msgstr ""
"a {name} tem um único suporte de ferramenta, e o trabalho usa duas "
"ferramentas diferentes"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "more than {count} points"
msgstr "mais de {count} pontos"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "the media does not fit on the {mat} cutting mat"
msgstr "a folha não cabe na base de corte {mat}"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "group {group}: point ({x}, {y}) mm lies outside the media"
msgstr "grupo {group}: o ponto ({x}, {y}) mm fica fora da folha"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "group {group}: point ({x}, {y}) mm lies outside the cut area"
msgstr "grupo {group}: o ponto ({x}, {y}) mm fica fora da área de corte"

#: src/opencutter/job/validate.py
#, python-brace-format
msgid "Blade Depth (TF) needs the {tool} detected in {holder}"
msgstr "Profundidade da lâmina (TF) precisa da {tool} detectada na {holder}"

#: src/opencutter/machines/profile.py
#, python-brace-format
msgid "OpenCutter recognizes this {name} but cannot drive it yet: {reason}."
msgstr ""
"O OpenCutter reconhece esta {name}, mas ainda não consegue controlá-la: "
"{reason}."

#: src/opencutter/machines/recognized.py
msgid ""
"there is no known way to stop it from the computer, and it does not report "
"which tools are loaded"
msgstr ""
"não há forma conhecida de pará-la a partir do computador, e ela não indica "
"quais ferramentas estão colocadas"

#: src/opencutter/machines/recognized.py
msgid ""
"it needs a USB connection, which OpenCutter does not have, and there is no "
"known way to stop it from the computer"
msgstr ""
"ela precisa de uma conexão USB, que o OpenCutter não tem, e não há forma "
"conhecida de pará-la a partir do computador"

#: src/opencutter/machines/recognized.py
msgid ""
"the work area of its trays, its tool height and the material thickness are "
"not known, and there is no way to confirm the work area before a cut"
msgstr ""
"a área de trabalho das suas bandejas, a altura da ferramenta e a espessura "
"do material não são conhecidas, e não há forma de confirmar a área de "
"trabalho antes de um corte"

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: the file is damaged or not an SVG ({error})."
msgstr ""
"Não foi possível ler {name}: está danificado ou não é um SVG ({error})."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: it is not an SVG file."
msgstr "Não foi possível ler {name}: não é um SVG."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: {error}"
msgstr "Não foi possível ler {name}: {error}"

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Nothing to cut in {name}: it has no visible paths or shapes."
msgstr "Nada para cortar em {name}: não tem caminhos nem formas visíveis."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} text object ignored: convert text to paths in Inkscape (Path > Object to "
"Path)."
msgid_plural ""
"{n} text objects ignored: convert text to paths in Inkscape (Path > Object "
"to Path)."
msgstr[0] ""
"{n} objeto de texto ignorado: converta o texto em caminhos no Inkscape "
"(Caminho > Objeto para caminho)."
msgstr[1] ""
"{n} objetos de texto ignorados: converta o texto em caminhos no Inkscape "
"(Caminho > Objeto para caminho)."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} image ignored: trace images in Inkscape (Path > Trace Bitmap) to cut "
"them."
msgid_plural ""
"{n} images ignored: trace images in Inkscape (Path > Trace Bitmap) to cut "
"them."
msgstr[0] ""
"{n} imagem ignorada: vetorize as imagens no Inkscape (Caminho > Vetorizar "
"bitmap) para cortá-las."
msgstr[1] ""
"{n} imagens ignoradas: vetorize as imagens no Inkscape (Caminho > Vetorizar "
"bitmap) para cortá-las."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} clipped or masked object: clips and masks are ignored, so the whole "
"object is cut."
msgid_plural ""
"{n} clipped or masked objects: clips and masks are ignored, so the whole "
"object is cut."
msgstr[0] ""
"{n} objeto recortado ou com máscara: os recortes e as máscaras são "
"ignorados, por isso o objeto é cortado inteiro."
msgstr[1] ""
"{n} objetos recortados ou com máscara: os recortes e as máscaras são "
"ignorados, por isso os objetos são cortados inteiros."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not open {name}: {error}."
msgstr "Não foi possível abrir {name}: {error}."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: the compressed file is damaged."
msgstr "Não foi possível ler {name}: o conteúdo comprimido está danificado."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid "Could not read {name}: the file is too large."
msgstr "Não foi possível ler {name}: é grande demais."
