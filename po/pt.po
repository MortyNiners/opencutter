msgstr "Pausar"

#: src/opencutter/gui/jobview.py
msgid "Pausing…"
msgstr "Pausando…"

#: src/opencutter/gui/jobview.py
msgid "Cancelling…"
msgstr "Cancelando…"

#: src/opencutter/gui/jobview.py
msgid ""
"Cancelling… A paused machine ends the job about 5 seconds after the stop."
msgstr ""
"Cancelando… Uma máquina em pausa termina o trabalho cerca de 5 segundos "
"depois do comando de parar."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid ""
"The machine still reports Paused {n} s after the stop. Press Unload on the "
"machine; if anything moves, press its power button."
msgstr ""
"A máquina ainda indica Em pausa {n} s depois do comando de parar. Pressione "
"Descarregar na máquina; se algo se mexer, pressione o botão de "
"ligar/desligar."

#: src/opencutter/gui/jobview.py
#, python-brace-format
