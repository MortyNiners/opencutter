#: src/opencutter/gui/firstrun.py
msgid ""
"Switch your machine on. Some machines accept a Bluetooth connection only "
"right after they are switched on: if the app can’t connect, switch it off "
"and on."
msgstr ""
"Ligue a sua máquina. Algumas máquinas só aceitam uma conexão Bluetooth logo "
"depois de serem ligadas: se o OpenCutter não conseguir conectar, desligue-a "
"e volte a ligá-la."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. It accepts a Bluetooth connection only right after "
"it is switched on: if the app can’t connect, switch it off and on."
msgstr ""
"Ligue a {machine}. Ela só aceita uma conexão Bluetooth logo depois de ser "
"ligada: se o OpenCutter não conseguir conectar, desligue-a e volte a ligá-la."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. If the app can’t connect, switch it off and on."
msgstr ""
"Ligue a {machine}. Se o OpenCutter não conseguir conectar, desligue-a e "
"volte a ligá-la."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid "Switch the {machine} on. OpenCutter then connects to it by itself."
msgstr "Ligue a {machine}. Depois, o OpenCutter faz a conexão automaticamente."

