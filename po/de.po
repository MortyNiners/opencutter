msgstr ""
"Nichts zu schneiden in {name}: Die Datei hat keine sichtbaren Pfade oder "
"Formen."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} text object ignored: convert text to paths in Inkscape (Path > Object to "
"Path)."
msgid_plural ""
"{n} text objects ignored: convert text to paths in Inkscape (Path > Object "
"to Path)."
msgstr[0] ""
"{n} Textobjekt ignoriert: Wandeln Sie Text in Inkscape in Pfade um (Pfad > "
"Objekt in Pfad umwandeln)."
msgstr[1] ""
"{n} Textobjekte ignoriert: Wandeln Sie Text in Inkscape in Pfade um (Pfad > "
"Objekt in Pfad umwandeln)."

#: src/opencutter/svg/importer.py
#, python-brace-format
msgid ""
"{n} image ignored: trace images in Inkscape (Path > Trace Bitmap) to cut "
"them."
msgid_plural ""
"{n} images ignored: trace images in Inkscape (Path > Trace Bitmap) to cut "
"them."
