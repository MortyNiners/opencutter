#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid ""
"OpenCutter cannot stop the machine without the connection. If it is still "
"moving, press its power button. Then switch it on again to reconnect."
msgstr ""
"Ohne Verbindung kann OpenCutter die Maschine nicht stoppen. Wenn sie sich "
"noch bewegt, drücken Sie ihre Ein-/Aus-Taste. Schalten Sie sie danach wieder "
"ein, um die Verbindung wiederherzustellen."

#: src/opencutter/gui/dialogs.py
msgid "Close"
msgstr "Schließen"

#: src/opencutter/gui/dialogs.py
msgid "Reconnect"
msgstr "Neu verbinden"

#: src/opencutter/gui/dialogs.py
msgid "The stop could not be sent"
msgstr "Der Stopp konnte nicht gesendet werden"

#: src/opencutter/gui/dialogs.py
msgid ""
"Press the machine's power button now. The window stays open; close it again "
"once the machine has stopped."
msgstr ""
"Drücken Sie jetzt die Ein-/Aus-Taste der Maschine. Das Fenster bleibt offen; "
"schließen Sie es erneut, sobald die Maschine gestoppt hat."

#: src/opencutter/gui/dialogs.py
msgid "OK"
msgstr "OK"

#: src/opencutter/gui/dialogs.py
msgid ""
"OpenCutter could not send the stop to the machine. If it moves, press its "
"power button now."
msgstr ""
"OpenCutter konnte den Stopp nicht an die Maschine senden. Wenn sie sich "
"bewegt, drücken Sie jetzt ihre Ein-/Aus-Taste."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Busy"
msgstr "Die Maschine meldet weiterhin „Belegt“"

#: src/opencutter/gui/dialogs.py
msgid ""
"The stop was sent, but the machine still reports Busy. If it moves, press "
"its power button now."
msgstr ""
"Der Stopp wurde gesendet, aber die Maschine meldet weiterhin „Belegt“. Wenn "
"sie sich bewegt, drücken Sie jetzt ihre Ein-/Aus-Taste."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Paused"
msgstr "Die Maschine meldet weiterhin „Pausiert“"

