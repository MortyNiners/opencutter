#, python-brace-format
msgid "{model} (firmware {lines})"
msgstr "{model} (Firmware {lines})"

#: src/opencutter/gui/machine.py
#, python-brace-format
msgid "OpenCutter drives these models: {models}. {hint}"
msgstr "OpenCutter steuert diese Modelle: {models}. {hint}"

#: src/opencutter/gui/machine.py
#, python-brace-format
msgid "{tool} (Detected)"
msgstr "{tool} (erkannt)"

#: src/opencutter/gui/machine.py
#: src/opencutter/gui/sidebar.py
#, python-brace-format
msgid "Unclear reply “{reply}”"
msgstr "Unklare Antwort „{reply}“"

#: src/opencutter/gui/machine.py
#, python-brace-format
msgid ""
"The {name} reported its tool as “{reply}”, which OpenCutter cannot read for "
"this model, so nothing is sent. Please report this reply."
msgstr ""
"Die {name} hat ihr Werkzeug als „{reply}“ gemeldet. OpenCutter kann das für "
"dieses Modell nicht lesen, daher wird nichts gesendet. Bitte melden Sie "
"diese Antwort."

#: src/opencutter/gui/machine.py
#, python-brace-format
msgid ""
"The {name} reported its tools as “{reply}”, which OpenCutter cannot read for "
"this model, so nothing is sent. Please report this reply."
msgstr ""
"Die {name} hat ihre Werkzeuge als „{reply}“ gemeldet. OpenCutter kann das "
"für dieses Modell nicht lesen, daher wird nichts gesendet. Bitte melden Sie "
"diese Antwort."

#: src/opencutter/gui/materials.py
msgid "Use Cut Settings"
msgstr "Schneideeinstellungen verwenden"

#: src/opencutter/gui/materials.py
msgid "Recent"
msgstr "Zuletzt verwendet"

#: src/opencutter/gui/materials.py
msgid "Other"
msgstr "Sonstige"

#: src/opencutter/gui/materials.py
msgid ""
"Basic set: one vinyl cut setting and a Sketch Pen starting point. For other "
"materials, start from the closest one and adjust Speed, Force and Blade "
"Depth in Cut Settings, then make a Test Cut."
msgstr ""
"Basissatz: eine Schneideeinstellung für Vinyl und ein Ausgangspunkt für den "
"Skizzierstift. Für andere Materialien beginnen Sie mit dem ähnlichsten, "
"passen Geschwindigkeit, Kraft und Klingentiefe in den Schneideeinstellungen "
"an und machen dann einen Testschnitt."

#: src/opencutter/gui/materials.py
msgid ""
"Basic set from the CAMEO 4. Start light: adjust Speed, Force and Blade Depth "
"in Cut Settings, then make a Test Cut."
msgstr ""
"Basissatz der CAMEO 4. Beginnen Sie mit niedrigen Werten: Passen Sie "
"Geschwindigkeit, Kraft und Klingentiefe in den Schneideeinstellungen an und "
"machen Sie dann einen Testschnitt."

#: src/opencutter/gui/materials.py
msgid "Search materials"
msgstr "Materialien suchen"

#: src/opencutter/gui/runner.py
msgid "Unload and load the mat on the machine, then send again."
msgstr ""
"Entladen und laden Sie die Matte an der Maschine und senden Sie dann erneut."

#: src/opencutter/gui/runner.py
#, python-brace-format
msgid "Unload and load the {label} mat on the machine, then send again."
msgstr ""
"Entladen und laden Sie die Matte {label} an der Maschine und senden Sie dann "
"erneut."

#: src/opencutter/gui/runner.py
msgid "The cut area could not be checked on this model."
msgstr "Der Schneidebereich konnte auf diesem Modell nicht geprüft werden."

#: src/opencutter/gui/runner.py
#, python-brace-format
msgid ""
"The cut area could not be checked on this model. The machine answered "
"“{reply}”."
msgstr ""
"Der Schneidebereich konnte auf diesem Modell nicht geprüft werden. Die "
"Maschine antwortete „{reply}“."

#: src/opencutter/gui/runner.py
#: src/opencutter/device/daemon.py
msgid "the Bluetooth link was lost"
msgstr "die Bluetooth-Verbindung ging verloren"

#: src/opencutter/gui/runner.py
msgid ""
"Stopped from outside the app (for example with the opencutter stop command). "
"Nothing was cut."
msgstr ""
"Von außerhalb der App gestoppt (zum Beispiel mit dem Befehl opencutter "
"stop). Es wurde nichts geschnitten."

#: src/opencutter/gui/runner.py
msgid "Previewing outline"
msgstr "Umriss wird abgefahren"

#: src/opencutter/gui/runner.py
msgid "Returning to origin"
msgstr "Rückkehr zum Nullpunkt"

#: src/opencutter/gui/runner.py
msgid ""
"The machine is still paused. Press its Pause key to go on, or Cancel Job."
msgstr ""
"Die Maschine ist weiterhin pausiert. Drücken Sie ihre Pause-Taste, um "
"fortzufahren, oder „Abbrechen“."

#: src/opencutter/gui/runner.py
msgid ""
"The machine has not reported Paused yet. It pauses only after the few moves "
"it has already planned, so it may still pause. If it keeps cutting, press "
"Pause here again, or Cancel Job to end the job."
msgstr ""
"Die Maschine hat noch nicht „Pausiert“ gemeldet. Sie pausiert erst nach den "
"wenigen bereits geplanten Bewegungen, daher kann sie noch pausieren. Wenn "
"sie weiterschneidet, drücken Sie hier erneut „Pause“ oder „Abbrechen“, um "
"den Auftrag zu beenden."

#: src/opencutter/gui/runner.py
#, python-brace-format
msgid "{what} was not sent: {reason}."
msgstr "„{what}“ wurde nicht gesendet: {reason}."

#: src/opencutter/gui/runner.py
#, python-brace-format
msgid ""
"{what} may not have reached the machine ({reason}). OpenCutter does not send "
"it again."
msgstr ""
"„{what}“ hat die Maschine möglicherweise nicht erreicht ({reason}). "
"OpenCutter sendet es nicht erneut."

#: src/opencutter/gui/runner.py
#, python-brace-format
msgid "the write failed: {error}"
msgstr "das Schreiben ist fehlgeschlagen: {error}"

#: src/opencutter/gui/runner.py
msgid "a Resume or Pause is already being sent"
msgstr "„Fortsetzen“ oder „Pause“ wird bereits gesendet"

#: src/opencutter/gui/runner.py
msgid "no answer"
msgstr "keine Antwort"

#: src/opencutter/gui/runner.py
msgid "no reason given"
msgstr "kein Grund angegeben"

#: src/opencutter/gui/runner.py
#, python-brace-format
msgid "The machine did not confirm the unit ({detail}). {hint}"
msgstr "Die Maschine hat die Einheit nicht bestätigt ({detail}). {hint}"

#: src/opencutter/gui/runner.py
msgid "The machine refused the job."
msgstr "Die Maschine hat den Auftrag abgelehnt."

#: src/opencutter/gui/runner.py
