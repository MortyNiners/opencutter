#: src/opencutter/gui/connection.py
msgid "Pair the machine once in <b>Settings → Bluetooth</b>."
msgstr "Associez la machine une fois dans <b>Paramètres → Bluetooth</b>."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"The {name} accepts a Bluetooth connection only right after it is switched "
"on. If the app can’t connect, switch the machine off and on."
msgstr ""
"La {name} n’accepte une connexion Bluetooth que juste après sa mise sous "
"tension. Si l’application ne parvient pas à se connecter, éteignez puis "
"rallumez la machine."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "If the app can’t connect to the {name}, switch the machine off and on."
msgstr ""
"Si l’application ne parvient pas à se connecter à la {name}, éteignez puis "
"rallumez la machine."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"Make sure the {name} is switched on and paired. If it still fails, switch it "
"off and on again."
msgstr ""
"Vérifiez que la {name} est allumée et associée. Si cela échoue encore, "
"éteignez-la puis rallumez-la."

#: src/opencutter/gui/connection.py
#, python-brace-format
