#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid ""
"OpenCutter cannot stop the machine without the connection. If it is still "
"moving, press its power button. Then switch it on again to reconnect."
msgstr ""
"OpenCutter ne peut pas arrêter la machine sans la connexion. Si elle bouge "
"encore, appuyez sur son bouton marche/arrêt. Rallumez-la ensuite pour vous "
"reconnecter."

#: src/opencutter/gui/dialogs.py
msgid "Close"
msgstr "Fermer"

#: src/opencutter/gui/dialogs.py
msgid "Reconnect"
msgstr "Se reconnecter"

#: src/opencutter/gui/dialogs.py
msgid "The stop could not be sent"
msgstr "L’arrêt n’a pas pu être envoyé"

#: src/opencutter/gui/dialogs.py
msgid ""
"Press the machine's power button now. The window stays open; close it again "
"once the machine has stopped."
msgstr ""
"Appuyez maintenant sur le bouton marche/arrêt de la machine. La fenêtre "
"reste ouverte ; fermez-la de nouveau une fois la machine arrêtée."

#: src/opencutter/gui/dialogs.py
msgid "OK"
msgstr "OK"

#: src/opencutter/gui/dialogs.py
msgid ""
"OpenCutter could not send the stop to the machine. If it moves, press its "
"power button now."
msgstr ""
"OpenCutter n’a pas pu envoyer l’arrêt à la machine. Si elle bouge, appuyez "
"maintenant sur son bouton marche/arrêt."

