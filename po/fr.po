#: src/opencutter/gui/jobview.py
msgid "Cancelling…"
msgstr "Annulation…"

#: src/opencutter/gui/jobview.py
msgid ""
"Cancelling… A paused machine ends the job about 5 seconds after the stop."
msgstr ""
"Annulation… Une machine en pause termine la tâche environ 5 secondes après "
"l’arrêt."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid ""
"The machine still reports Paused {n} s after the stop. Press Unload on the "
"machine; if anything moves, press its power button."
msgstr ""
"La machine indique toujours « En pause » {n} s après l’arrêt. Appuyez sur "
"Décharger sur la machine ; si quelque chose bouge, appuyez sur son bouton "
"marche/arrêt."

#: src/opencutter/gui/jobview.py
#, python-brace-format
msgid "{step} progress"
