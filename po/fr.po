msgstr ""
"Allumez votre machine. Certaines machines n’acceptent une connexion "
"Bluetooth que juste après leur mise sous tension : si l’application ne "
"parvient pas à se connecter, éteignez-la puis rallumez-la."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. It accepts a Bluetooth connection only right after "
"it is switched on: if the app can’t connect, switch it off and on."
msgstr ""
"Allumez la {machine}. Elle n’accepte une connexion Bluetooth que juste après "
"sa mise sous tension : si l’application ne parvient pas à se connecter, "
"éteignez-la puis rallumez-la."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
msgid ""
"Switch the {machine} on. If the app can’t connect, switch it off and on."
msgstr ""
"Allumez la {machine}. Si l’application ne parvient pas à se connecter, "
"éteignez-la puis rallumez-la."

#: src/opencutter/gui/firstrun.py
#, python-brace-format
