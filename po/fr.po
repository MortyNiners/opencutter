msgstr ""
"Libère la {name} pour que d’autres applications puissent s’y connecter."

#: src/opencutter/gui/connection.py
msgid "Available when the job has ended."
msgstr "Disponible une fois la tâche terminée."

#: src/opencutter/gui/connection.py
