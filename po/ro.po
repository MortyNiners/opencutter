#: src/opencutter/gui/dialogs.py
#: src/opencutter/gui/window.py
msgid ""
"OpenCutter cannot stop the machine without the connection. If it is still "
"moving, press its power button. Then switch it on again to reconnect."
msgstr ""
"Fără conexiune, OpenCutter nu poate opri mașina. Dacă încă se mișcă, apăsați "
"butonul ei de pornire/oprire. Apoi porniți-o din nou pentru a vă reconecta."

#: src/opencutter/gui/dialogs.py
msgid "Close"
msgstr "Închide"

#: src/opencutter/gui/dialogs.py
msgid "Reconnect"
msgstr "Reconectează"

#: src/opencutter/gui/dialogs.py
msgid "The stop could not be sent"
msgstr "Oprirea nu a putut fi trimisă"

#: src/opencutter/gui/dialogs.py
msgid ""
"Press the machine's power button now. The window stays open; close it again "
"once the machine has stopped."
msgstr ""
"Apăsați acum butonul de pornire/oprire al mașinii. Fereastra rămâne "
"deschisă; închideți-o din nou după ce mașina s-a oprit."

#: src/opencutter/gui/dialogs.py
msgid "OK"
msgstr "OK"

#: src/opencutter/gui/dialogs.py
msgid ""
"OpenCutter could not send the stop to the machine. If it moves, press its "
"power button now."
msgstr ""
"OpenCutter nu a putut trimite oprirea către mașină. Dacă se mișcă, apăsați "
"acum butonul ei de pornire/oprire."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Busy"
msgstr "Mașina raportează în continuare starea Ocupată"

#: src/opencutter/gui/dialogs.py
msgid ""
"The stop was sent, but the machine still reports Busy. If it moves, press "
"its power button now."
msgstr ""
"Oprirea a fost trimisă, dar mașina raportează în continuare starea Ocupată. "
"Dacă se mișcă, apăsați acum butonul ei de pornire/oprire."

#: src/opencutter/gui/dialogs.py
msgid "The machine still reports Paused"
msgstr "Mașina raportează în continuare starea În pauză"

