#: src/opencutter/gui/connection.py
msgid "Pair the machine once in <b>Settings → Bluetooth</b>."
msgstr "Asociați mașina o singură dată în <b>Configurări → Bluetooth</b>."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"The {name} accepts a Bluetooth connection only right after it is switched "
"on. If the app can’t connect, switch the machine off and on."
msgstr ""
"{name} acceptă o conexiune Bluetooth doar imediat după pornire. Dacă "
"aplicația nu se poate conecta, opriți și porniți din nou mașina."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid "If the app can’t connect to the {name}, switch the machine off and on."
msgstr ""
"Dacă aplicația nu se poate conecta la {name}, opriți și porniți din nou "
"mașina."

#: src/opencutter/gui/connection.py
#, python-brace-format
msgid ""
"Make sure the {name} is switched on and paired. If it still fails, switch it "
"off and on again."
msgstr ""
"Asigurați-vă că {name} este pornită și asociată. Dacă tot nu merge, opriți-o "
"și porniți-o din nou."

#: src/opencutter/gui/connection.py
#, python-brace-format
